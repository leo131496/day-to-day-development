# 仅首次初始化管理员 admin 时生效，至少 12 字符。留空将生成随机密码并写入 data/首次登录密码.txt。
BOARD_PASSWORD=
# 上线到 HTTPS 域名后填实际来源，例如 https://projects.example.com（不带结尾斜线）
BOARD_ORIGIN=
# HTTPS 上线时设置为 1，本机 HTTP 使用 0。
BOARD_COOKIE_SECURE=0
# 本机默认 sqlite；免费云部署使用 turso，连接失败时不会降级到本机保存。
BOARD_DATABASE_MODE=sqlite
# 以下仅填写在私密环境变量 / .env 中，绝不提交 GitHub。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
