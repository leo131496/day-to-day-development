# Native Python hosting on the free Northflank Sandbox. Business data lives in Turso.
FROM python:3.12-slim AS checked
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
COPY requirements-cloud.txt /app/
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-cloud.txt
COPY server.py work_calendar.py work_import.py cloud_store.py /app/
COPY static /app/static
COPY seed /app/seed
COPY scripts /app/scripts
COPY tests /app/tests
RUN python -B scripts/check_deploy.py

FROM python:3.12-slim
WORKDIR /app
COPY --from=checked /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=checked /app/server.py /app/work_calendar.py /app/work_import.py /app/cloud_store.py /app/
COPY --from=checked /app/static /app/static
COPY --from=checked /app/seed /app/seed
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BOARD_HOST=0.0.0.0 PORT=8765
ENV BOARD_DATABASE_MODE=turso BOARD_DATA_DIR=/tmp/project-space-cache BOARD_COOKIE_SECURE=1
RUN useradd --uid 10001 --create-home board
USER board
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/api/health', timeout=8)"
CMD ["python", "-B", "server.py"]
